			"com.magmaxy.WarpingOcular"
		],
		"client": [
			"com.magmaxy.client.WarpingOcularClient"
		]
	},
	"mixins": [
		"warping-ocular.mixins.json",
		{
			"config": "warping-ocular.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": ">=26.1",
