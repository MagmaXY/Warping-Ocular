{
	"schemaVersion": 1,
	"id": "warping-ocular",
	"version": "${version}",
	"name": "Warping Ocular",
	"description": "Задумывались ли вы о том, что в современном майнкрафте подзорная труба практически бесполезна? Данный мод стремится это исправить и сделать из неё юзабельный предмет.",
	"authors": [
		"MagmaXY"
	],
	"contact": {
		"homepage": "https://github.com/MagmaXY/Warping-Ocular",
